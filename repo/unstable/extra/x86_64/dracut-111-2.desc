dracut-111-2-x86_64.pkg.tar.zst

%NAME%
dracut

%BASE%
dracut

%VERSION%
111-2

%DESC%
An event driven initramfs infrastructure

%CSIZE%
559889

%ISIZE%
1485019

%MD5SUM%
8764fd809babcbeea31f0cc39351f83b

%SHA256SUM%
83d90681ca780dd61d57e72ccbfa9a9512426bf8b88de4badf0b43d7808c059b

%PGPSIG%


