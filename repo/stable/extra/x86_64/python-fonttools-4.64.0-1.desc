python-fonttools-4.64.0-1-x86_64.pkg.tar.zst

%NAME%
python-fonttools

%BASE%
python-fonttools

%VERSION%
4.64.0-1

%DESC%
A library to manipulate font files from Python

%CSIZE%
3170164

